CREATE VERTEX Customer (PRIMARY_ID customer_id STRING, source STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX Card (PRIMARY_ID card_id STRING, customer_id STRING, card1 STRING, card2 STRING, card3 STRING, card4 STRING, card5 STRING, card6 STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX Transaction (PRIMARY_ID transaction_id STRING, customer_id STRING, card_id STRING, ts DATETIME, amount DOUBLE, product_cd STRING, channel STRING, risk_score DOUBLE, addr1 STRING, addr2 STRING, dist1 DOUBLE, purchaser_email STRING, recipient_email STRING, c1 DOUBLE, c2 DOUBLE, c3 DOUBLE, c5 DOUBLE, c6 DOUBLE, d1 DOUBLE, d2 DOUBLE, d3 DOUBLE, d4 DOUBLE, d10 DOUBLE, m1 STRING, m2 STRING, m3 STRING, m4 STRING, m5 STRING, m6 STRING, id_15 STRING, id_23 STRING, id_30 STRING, id_31 STRING, id_33 STRING, id_34 STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX DeviceProfile (PRIMARY_ID device_id STRING, profile STRING, device_type STRING, device_info STRING, os STRING, browser STRING, screen STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX EmailDomain (PRIMARY_ID domain STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX BillingRegion (PRIMARY_ID region STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX ClosedCase (PRIMARY_ID case_id STRING, customer_id STRING, card_id STRING, opened_at DATETIME, closed_at DATETIME, outcome STRING, pattern STRING, exposure_usd DOUBLE, report_filed BOOL, analyst_notes STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX Case (PRIMARY_ID graph_case_id STRING, case_id STRING, verdict STRING, fraud_probability DOUBLE, pattern STRING, pattern_description STRING, status STRING, exposure_usd DOUBLE, summary STRING) WITH primary_id_as_attribute="true";
CREATE VERTEX PolicyDoc (PRIMARY_ID doc_id STRING, title STRING, category STRING, content STRING, embedding LIST<DOUBLE>) WITH primary_id_as_attribute="true";

CREATE DIRECTED EDGE OWNS (FROM Customer, TO Card);
CREATE DIRECTED EDGE MADE (FROM Card, TO Transaction);
CREATE DIRECTED EDGE FROM_DEVICE (FROM Transaction, TO DeviceProfile);
CREATE DIRECTED EDGE PURCHASER_EMAIL (FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE RECIPIENT_EMAIL (FROM Transaction, TO EmailDomain);
CREATE DIRECTED EDGE BILLED_IN (FROM Transaction, TO BillingRegion);
CREATE DIRECTED EDGE NEXT (FROM Transaction, TO Transaction, ts_gap_seconds DOUBLE);

CREATE DIRECTED EDGE INVOLVES (FROM ClosedCase, TO Transaction);
CREATE DIRECTED EDGE ON_CARD (FROM ClosedCase, TO Card);
CREATE DIRECTED EDGE CONNECTED_TO (FROM ClosedCase, TO Card);

CREATE DIRECTED EDGE CASE_INVOLVES (FROM Case, TO Transaction);
CREATE DIRECTED EDGE CASE_ON_CARD (FROM Case, TO Card);
CREATE DIRECTED EDGE CASE_CONNECTED_TO (FROM Case, TO Card);
CREATE DIRECTED EDGE CASE_USED_DEVICE (FROM Case, TO DeviceProfile);
CREATE DIRECTED EDGE SIMILAR_TO (FROM Case, TO ClosedCase, similarity DOUBLE);

CREATE GRAPH FraudInvestigation(*);
